[Unit]
Description=Gotham mixnet relay (Crypto project)
Documentation=https://github.com/0x9Angel/gotham-relay#readme
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gotham
Group=gotham
WorkingDirectory=/opt/gotham
EnvironmentFile=/etc/gotham/relay.env
ExecStart=/opt/gotham/bin/gotham-relay run \
    --key-file /opt/gotham/state/relay.key \
    --listen-port ${GOTHAM_PORT} \
    --authority-url ${GOTHAM_AUTHORITY_URL} \
    --advertise-addr ${GOTHAM_ADVERTISE_ADDR} \
    --tier ${GOTHAM_TIER} \
    --replay-size 1000000 \
    --replay-ttl-secs 300 \
    --replay-cache-path /opt/gotham/state/replay.bin \
    $GOTHAM_EXTRA_ARGS
Restart=always
RestartSec=5
StartLimitInterval=200
StartLimitBurst=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadWritePaths=/opt/gotham/state /var/log/gotham
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

LimitNOFILE=65536
TasksMax=4096

Environment="RUST_LOG=info,crypto_gotham_relay=info"
StandardOutput=append:/var/log/gotham/relay.log
StandardError=append:/var/log/gotham/relay.err

[Install]
WantedBy=multi-user.target
